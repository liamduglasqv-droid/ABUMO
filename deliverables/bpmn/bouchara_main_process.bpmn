<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BoucharaMaison" targetNamespace="http://bouchara-maison/bpmn" exporter="python" exporterVersion="1">
<bpmn:collaboration id="Collab">
<bpmn:participant id="P_customer" name="Customer" processRef="Process_Customer" />
<bpmn:participant id="P_bouchara" name="Bouchara Maison" processRef="Process_Bouchara" />
<bpmn:participant id="P_bazar" name="BazarChic (campaigns)" />
<bpmn:participant id="P_ai" name="AI visualisation provider" />
<bpmn:participant id="P_pay" name="Payment provider" />
<bpmn:participant id="P_supp" name="Product suppliers" />
<bpmn:participant id="P_manu" name="Custom manufacturers" />
<bpmn:participant id="P_deliv" name="Delivery partner" />
<bpmn:participant id="P_inst" name="Installation partner" />
<bpmn:messageFlow id="m_P_bazar_c_start" sourceRef="P_bazar" targetRef="c_start" />
<bpmn:messageFlow id="m_c_visit_b_start" sourceRef="c_visit" targetRef="b_start" />
<bpmn:messageFlow id="m_c_project_b_save" sourceRef="c_project" targetRef="b_save" />
<bpmn:messageFlow id="m_b_render_P_ai" sourceRef="b_render" targetRef="P_ai" />
<bpmn:messageFlow id="m_P_ai_b_render" sourceRef="P_ai" targetRef="b_render" />
<bpmn:messageFlow id="m_b_render_c_compare" sourceRef="b_render" targetRef="c_compare" />
<bpmn:messageFlow id="m_c_store_a_open" sourceRef="c_store" targetRef="a_open" />
<bpmn:messageFlow id="m_c_confirm_b_basket" sourceRef="c_confirm" targetRef="b_basket" />
<bpmn:messageFlow id="m_b_checkout_c_pay" sourceRef="b_checkout" targetRef="c_pay" />
<bpmn:messageFlow id="m_c_pay_b_checkout" sourceRef="c_pay" targetRef="b_checkout" />
<bpmn:messageFlow id="m_b_checkout_P_pay" sourceRef="b_checkout" targetRef="P_pay" />
<bpmn:messageFlow id="m_P_pay_b_checkout" sourceRef="P_pay" targetRef="b_checkout" />
<bpmn:messageFlow id="m_s_stock_P_supp" sourceRef="s_stock" targetRef="P_supp" />
<bpmn:messageFlow id="m_s_custom_P_manu" sourceRef="s_custom" targetRef="P_manu" />
<bpmn:messageFlow id="m_P_manu_s_custom" sourceRef="P_manu" targetRef="s_custom" />
<bpmn:messageFlow id="m_s_book_P_deliv" sourceRef="s_book" targetRef="P_deliv" />
<bpmn:messageFlow id="m_P_deliv_s_book" sourceRef="P_deliv" targetRef="s_book" />
<bpmn:messageFlow id="m_s_install_P_inst" sourceRef="s_install" targetRef="P_inst" />
<bpmn:messageFlow id="m_s_track_c_receive" sourceRef="s_track" targetRef="c_receive" />
<bpmn:messageFlow id="m_cs_survey_c_survey" sourceRef="cs_survey" targetRef="c_survey" />
<bpmn:messageFlow id="m_c_survey_cs_survey" sourceRef="c_survey" targetRef="cs_survey" />
</bpmn:collaboration>
<bpmn:process id="Process_Customer" isExecutable="false">
<bpmn:startEvent id="c_start" name="Room to refresh"><bpmn:outgoing>f_c_start_c_visit</bpmn:outgoing><bpmn:messageEventDefinition id="med_c_start" /></bpmn:startEvent>
<bpmn:task id="c_visit" name="Visit website or store"><bpmn:incoming>f_c_start_c_visit</bpmn:incoming><bpmn:outgoing>f_c_visit_c_g0</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="c_g0" name="Use AI room planner?"><bpmn:incoming>f_c_visit_c_g0</bpmn:incoming><bpmn:outgoing>f_c_g0_c_project</bpmn:outgoing><bpmn:outgoing>f_c_g0_c_confirm</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="c_project" name="Create room project (room, budget)"><bpmn:incoming>f_c_g0_c_project</bpmn:incoming><bpmn:outgoing>f_c_project_c_compare</bpmn:outgoing></bpmn:task>
<bpmn:task id="c_compare" name="Compare previews, swap items, order samples"><bpmn:incoming>f_c_project_c_compare</bpmn:incoming><bpmn:outgoing>f_c_compare_c_g1</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="c_g1" name="Advice or custom item?"><bpmn:incoming>f_c_compare_c_g1</bpmn:incoming><bpmn:outgoing>f_c_g1_c_store</bpmn:outgoing><bpmn:outgoing>f_c_g1_c_confirm</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="c_store" name="Visit store with saved project"><bpmn:incoming>f_c_g1_c_store</bpmn:incoming><bpmn:outgoing>f_c_store_c_confirm</bpmn:outgoing></bpmn:task>
<bpmn:task id="c_confirm" name="Confirm basket (online or in store)"><bpmn:incoming>f_c_g0_c_confirm</bpmn:incoming><bpmn:incoming>f_c_g1_c_confirm</bpmn:incoming><bpmn:incoming>f_c_store_c_confirm</bpmn:incoming><bpmn:outgoing>f_c_confirm_c_pay</bpmn:outgoing></bpmn:task>
<bpmn:task id="c_pay" name="Review summary, choose options, pay"><bpmn:incoming>f_c_confirm_c_pay</bpmn:incoming><bpmn:outgoing>f_c_pay_c_receive</bpmn:outgoing></bpmn:task>
<bpmn:task id="c_receive" name="Receive delivery and installation"><bpmn:incoming>f_c_pay_c_receive</bpmn:incoming><bpmn:outgoing>f_c_receive_c_survey</bpmn:outgoing></bpmn:task>
<bpmn:task id="c_survey" name="Answer survey or report issue"><bpmn:incoming>f_c_receive_c_survey</bpmn:incoming><bpmn:outgoing>f_c_survey_c_end</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="c_end" name="Room done"><bpmn:incoming>f_c_survey_c_end</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="f_c_start_c_visit" sourceRef="c_start" targetRef="c_visit" />
<bpmn:sequenceFlow id="f_c_visit_c_g0" sourceRef="c_visit" targetRef="c_g0" />
<bpmn:sequenceFlow id="f_c_g0_c_project" name="Yes" sourceRef="c_g0" targetRef="c_project" />
<bpmn:sequenceFlow id="f_c_g0_c_confirm" name="No" sourceRef="c_g0" targetRef="c_confirm" />
<bpmn:sequenceFlow id="f_c_project_c_compare" sourceRef="c_project" targetRef="c_compare" />
<bpmn:sequenceFlow id="f_c_compare_c_g1" sourceRef="c_compare" targetRef="c_g1" />
<bpmn:sequenceFlow id="f_c_g1_c_store" name="Yes" sourceRef="c_g1" targetRef="c_store" />
<bpmn:sequenceFlow id="f_c_g1_c_confirm" name="No" sourceRef="c_g1" targetRef="c_confirm" />
<bpmn:sequenceFlow id="f_c_store_c_confirm" sourceRef="c_store" targetRef="c_confirm" />
<bpmn:sequenceFlow id="f_c_confirm_c_pay" sourceRef="c_confirm" targetRef="c_pay" />
<bpmn:sequenceFlow id="f_c_pay_c_receive" sourceRef="c_pay" targetRef="c_receive" />
<bpmn:sequenceFlow id="f_c_receive_c_survey" sourceRef="c_receive" targetRef="c_survey" />
<bpmn:sequenceFlow id="f_c_survey_c_end" sourceRef="c_survey" targetRef="c_end" />
</bpmn:process>
<bpmn:process id="Process_Bouchara" isExecutable="false">
<bpmn:laneSet id="LS">
<bpmn:lane id="Lane_PLAT" name="Digital platform">
<bpmn:flowNodeRef>b_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_gp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_save</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_suggest</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_render</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_fallback</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_xa</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_ga</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_xm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_basket</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_stock</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_subst</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_checkout</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>b_order</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_render</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_ADV" name="Store advisers">
<bpmn:flowNodeRef>a_open</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a_advise</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a_validate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>a_confirm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_SC" name="Supply chain">
<bpmn:flowNodeRef>s_split</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_stock</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_custom</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_book</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_g5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_install</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_track</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s_replan</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_late</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_CS" name="Customer service">
<bpmn:flowNodeRef>cs_survey</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_g6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_after</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_invite</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="b_start" name="Session starts"><bpmn:outgoing>f_b_start_b_gp</bpmn:outgoing><bpmn:messageEventDefinition id="med_b_start" /></bpmn:startEvent>
<bpmn:exclusiveGateway id="b_gp" name="Project created?"><bpmn:incoming>f_b_start_b_gp</bpmn:incoming><bpmn:outgoing>f_b_gp_b_save</bpmn:outgoing><bpmn:outgoing>f_b_gp_b_xa</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_save" name="Save project and project ID"><bpmn:incoming>f_b_gp_b_save</bpmn:incoming><bpmn:outgoing>f_b_save_b_suggest</bpmn:outgoing></bpmn:task>
<bpmn:task id="b_suggest" name="Suggest coordinated room within budget"><bpmn:incoming>f_b_save_b_suggest</bpmn:incoming><bpmn:outgoing>f_b_suggest_b_render</bpmn:outgoing></bpmn:task>
<bpmn:task id="b_render" name="Render 3 options in parallel (fast preview first)"><bpmn:incoming>f_b_suggest_b_render</bpmn:incoming><bpmn:outgoing>f_b_render_b_xa</bpmn:outgoing></bpmn:task>
<bpmn:task id="b_fallback" name="Fallback: product photos + advice offer"><bpmn:incoming>f_t_render_b_fallback</bpmn:incoming><bpmn:outgoing>f_b_fallback_b_xa</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_xa" name=""><bpmn:incoming>f_b_gp_b_xa</bpmn:incoming><bpmn:incoming>f_b_render_b_xa</bpmn:incoming><bpmn:incoming>f_b_fallback_b_xa</bpmn:incoming><bpmn:outgoing>f_b_xa_b_ga</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="b_ga" name="Advice requested?"><bpmn:incoming>f_b_xa_b_ga</bpmn:incoming><bpmn:outgoing>f_b_ga_a_open</bpmn:outgoing><bpmn:outgoing>f_b_ga_b_xm</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="a_open" name="Open shared project; readiness check"><bpmn:incoming>f_b_ga_a_open</bpmn:incoming><bpmn:outgoing>f_a_open_a_advise</bpmn:outgoing></bpmn:task>
<bpmn:task id="a_advise" name="Advise on materials, sizes, samples"><bpmn:incoming>f_a_open_a_advise</bpmn:incoming><bpmn:outgoing>f_a_advise_a_g4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="a_g4" name="Custom item?"><bpmn:incoming>f_a_advise_a_g4</bpmn:incoming><bpmn:outgoing>f_a_g4_a_validate</bpmn:outgoing><bpmn:outgoing>f_a_g4_a_confirm</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="a_validate" name="Validate spec with production checklist"><bpmn:incoming>f_a_g4_a_validate</bpmn:incoming><bpmn:outgoing>f_a_validate_a_confirm</bpmn:outgoing></bpmn:task>
<bpmn:task id="a_confirm" name="Confirm selection in shared project"><bpmn:incoming>f_a_g4_a_confirm</bpmn:incoming><bpmn:incoming>f_a_validate_a_confirm</bpmn:incoming><bpmn:outgoing>f_a_confirm_b_xm</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_xm" name=""><bpmn:incoming>f_b_ga_b_xm</bpmn:incoming><bpmn:incoming>f_a_confirm_b_xm</bpmn:incoming><bpmn:outgoing>f_b_xm_b_basket</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="b_basket" name="Basket confirmed"><bpmn:incoming>f_b_xm_b_basket</bpmn:incoming><bpmn:outgoing>f_b_basket_b_stock</bpmn:outgoing><bpmn:messageEventDefinition id="med_b_basket" /></bpmn:intermediateCatchEvent>
<bpmn:task id="b_stock" name="Check stock and dates for whole room"><bpmn:incoming>f_b_basket_b_stock</bpmn:incoming><bpmn:outgoing>f_b_stock_b_g2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_g2" name="Room complete?"><bpmn:incoming>f_b_stock_b_g2</bpmn:incoming><bpmn:outgoing>f_b_g2_b_subst</bpmn:outgoing><bpmn:outgoing>f_b_g2_b_checkout</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_subst" name="Offer substitute, split delivery or wait"><bpmn:incoming>f_b_g2_b_subst</bpmn:incoming><bpmn:outgoing>f_b_subst_b_checkout</bpmn:outgoing></bpmn:task>
<bpmn:task id="b_checkout" name="Checkout: lead times, installation, terms"><bpmn:incoming>f_b_g2_b_checkout</bpmn:incoming><bpmn:incoming>f_b_subst_b_checkout</bpmn:incoming><bpmn:incoming>f_b_g3_b_checkout</bpmn:incoming><bpmn:outgoing>f_b_checkout_b_g3</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="b_g3" name="Paid?"><bpmn:incoming>f_b_checkout_b_g3</bpmn:incoming><bpmn:outgoing>f_b_g3_b_order</bpmn:outgoing><bpmn:outgoing>f_b_g3_b_checkout</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="b_order" name="Create order linked to project"><bpmn:incoming>f_b_g3_b_order</bpmn:incoming><bpmn:outgoing>f_b_order_s_split</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="s_split" name=""><bpmn:incoming>f_b_order_s_split</bpmn:incoming><bpmn:outgoing>f_s_split_s_stock</bpmn:outgoing><bpmn:outgoing>f_s_split_s_custom</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="s_stock" name="Pick from stock or drop-ship"><bpmn:incoming>f_s_split_s_stock</bpmn:incoming><bpmn:outgoing>f_s_stock_s_join</bpmn:outgoing></bpmn:task>
<bpmn:task id="s_custom" name="Send validated spec; track production"><bpmn:incoming>f_s_split_s_custom</bpmn:incoming><bpmn:outgoing>f_s_custom_s_join</bpmn:outgoing></bpmn:task>
<bpmn:parallelGateway id="s_join" name=""><bpmn:incoming>f_s_stock_s_join</bpmn:incoming><bpmn:incoming>f_s_custom_s_join</bpmn:incoming><bpmn:outgoing>f_s_join_s_book</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:task id="s_book" name="Confirm lead time; book delivery slot"><bpmn:incoming>f_s_join_s_book</bpmn:incoming><bpmn:outgoing>f_s_book_s_g5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="s_g5" name="Installation ordered?"><bpmn:incoming>f_s_book_s_g5</bpmn:incoming><bpmn:outgoing>f_s_g5_s_install</bpmn:outgoing><bpmn:outgoing>f_s_g5_s_track</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="s_install" name="Book installation on delivery day"><bpmn:incoming>f_s_g5_s_install</bpmn:incoming><bpmn:outgoing>f_s_install_s_track</bpmn:outgoing></bpmn:task>
<bpmn:task id="s_track" name="Track delivery to promised date"><bpmn:incoming>f_s_g5_s_track</bpmn:incoming><bpmn:incoming>f_s_install_s_track</bpmn:incoming><bpmn:incoming>f_s_replan_s_track</bpmn:incoming><bpmn:outgoing>f_s_track_cs_survey</bpmn:outgoing></bpmn:task>
<bpmn:task id="s_replan" name="Warn customer and re-plan"><bpmn:incoming>f_t_late_s_replan</bpmn:incoming><bpmn:outgoing>f_s_replan_s_track</bpmn:outgoing></bpmn:task>
<bpmn:task id="cs_survey" name="Send care guide and survey"><bpmn:incoming>f_s_track_cs_survey</bpmn:incoming><bpmn:outgoing>f_cs_survey_cs_g6</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="cs_g6" name="Issue reported?"><bpmn:incoming>f_cs_survey_cs_g6</bpmn:incoming><bpmn:outgoing>f_cs_g6_cs_after</bpmn:outgoing><bpmn:outgoing>f_cs_g6_cs_invite</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="cs_after" name="After-sales: replace or remake"><bpmn:incoming>f_cs_g6_cs_after</bpmn:incoming><bpmn:outgoing>f_cs_after_cs_invite</bpmn:outgoing></bpmn:task>
<bpmn:task id="cs_invite" name="Invite to next room project"><bpmn:incoming>f_cs_g6_cs_invite</bpmn:incoming><bpmn:incoming>f_cs_after_cs_invite</bpmn:incoming><bpmn:outgoing>f_cs_invite_cs_end</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="cs_end" name="Room delivered, project open"><bpmn:incoming>f_cs_invite_cs_end</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="t_render" name="&gt; 10 s" attachedToRef="b_render" cancelActivity="true"><bpmn:outgoing>f_t_render_b_fallback</bpmn:outgoing><bpmn:timerEventDefinition id="ted_t_render" /></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="t_late" name="Date at risk" attachedToRef="s_track" cancelActivity="true"><bpmn:outgoing>f_t_late_s_replan</bpmn:outgoing><bpmn:timerEventDefinition id="ted_t_late" /></bpmn:boundaryEvent>
<bpmn:sequenceFlow id="f_b_start_b_gp" sourceRef="b_start" targetRef="b_gp" />
<bpmn:sequenceFlow id="f_b_gp_b_save" name="Yes" sourceRef="b_gp" targetRef="b_save" />
<bpmn:sequenceFlow id="f_b_gp_b_xa" name="No" sourceRef="b_gp" targetRef="b_xa" />
<bpmn:sequenceFlow id="f_b_save_b_suggest" sourceRef="b_save" targetRef="b_suggest" />
<bpmn:sequenceFlow id="f_b_suggest_b_render" sourceRef="b_suggest" targetRef="b_render" />
<bpmn:sequenceFlow id="f_b_render_b_xa" sourceRef="b_render" targetRef="b_xa" />
<bpmn:sequenceFlow id="f_t_render_b_fallback" sourceRef="t_render" targetRef="b_fallback" />
<bpmn:sequenceFlow id="f_b_fallback_b_xa" sourceRef="b_fallback" targetRef="b_xa" />
<bpmn:sequenceFlow id="f_b_xa_b_ga" sourceRef="b_xa" targetRef="b_ga" />
<bpmn:sequenceFlow id="f_b_ga_a_open" name="Yes" sourceRef="b_ga" targetRef="a_open" />
<bpmn:sequenceFlow id="f_b_ga_b_xm" name="No" sourceRef="b_ga" targetRef="b_xm" />
<bpmn:sequenceFlow id="f_a_open_a_advise" sourceRef="a_open" targetRef="a_advise" />
<bpmn:sequenceFlow id="f_a_advise_a_g4" sourceRef="a_advise" targetRef="a_g4" />
<bpmn:sequenceFlow id="f_a_g4_a_validate" name="Yes" sourceRef="a_g4" targetRef="a_validate" />
<bpmn:sequenceFlow id="f_a_g4_a_confirm" name="No" sourceRef="a_g4" targetRef="a_confirm" />
<bpmn:sequenceFlow id="f_a_validate_a_confirm" sourceRef="a_validate" targetRef="a_confirm" />
<bpmn:sequenceFlow id="f_a_confirm_b_xm" sourceRef="a_confirm" targetRef="b_xm" />
<bpmn:sequenceFlow id="f_b_xm_b_basket" sourceRef="b_xm" targetRef="b_basket" />
<bpmn:sequenceFlow id="f_b_basket_b_stock" sourceRef="b_basket" targetRef="b_stock" />
<bpmn:sequenceFlow id="f_b_stock_b_g2" sourceRef="b_stock" targetRef="b_g2" />
<bpmn:sequenceFlow id="f_b_g2_b_subst" name="No" sourceRef="b_g2" targetRef="b_subst" />
<bpmn:sequenceFlow id="f_b_g2_b_checkout" name="Yes" sourceRef="b_g2" targetRef="b_checkout" />
<bpmn:sequenceFlow id="f_b_subst_b_checkout" sourceRef="b_subst" targetRef="b_checkout" />
